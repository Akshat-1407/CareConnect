# ==========================================
# CareConnect Backend Environment Configuration
# ==========================================

# Server Configuration
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Database Option 1: Local MySQL
# ------------------------------------------
DB_ENGINE=mysql
DB_NAME=careconnect
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------
# Database Option 2: TiDB Cloud Serverless (Recommended for Deployment)
#
# TiDB Cloud provides a single connection URL in the Connect modal:
# TIDB_URL=mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/careconnect?ssl_mode=VERIFY_IDENTITY
#
# Or set individual variables (SSL is auto-enabled when host contains tidbcloud.com):
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<prefix>.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=careconnect
# DB_SSL=True
# ------------------------------------------

# Optional: Auto-create Admin on deployment (in Render build.sh)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@careconnect.com
# ADMIN_PASSWORD=YourSecureAdminPassword123!

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
