# Server Configuration
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Option A: Individual Variables - for local or Railway manual credentials)
DB_ENGINE=mysql
DB_NAME=careconnect
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Database Configuration (Option B: Connection String - e.g., Railway MYSQL_URL / DATABASE_URL)
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
